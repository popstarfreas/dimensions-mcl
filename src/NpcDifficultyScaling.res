let buildLookup = (): array<bool> => {
  let lookup = Array.make(~length=npcTypeCount, false)

  needsScalingFromBaseNpcStatsNpcTypes->Array.forEach(npcType => {
    if npcType >= 0 && npcType < npcTypeCount {
      lookup->Array.setUnsafe(npcType, true)
    }
  })

  needsExpertScalingNpcTypes->Array.forEach(npcType => {
    if npcType >= 0 && npcType < npcTypeCount {
      lookup->Array.setUnsafe(npcType, true)
    }
  })

  lookup
}

let difficultyScalingLookup = buildLookup()

let needsExpertScaling = (npcType: int): bool => {
  npcType >= 0 && npcType < npcTypeCount && needsExpertScalingNpcTypes->Array.some(v => v == npcType)
}

let needsScalingFromBaseNpcStats = (npcType: int): bool => {
  npcType >= 0 && npcType < npcTypeCount && needsScalingFromBaseNpcStatsNpcTypes->Array.some(v => v == npcType)
}

let needsDifficultyScaling = (npcType: int): bool => {
  if npcType < 0 || npcType >= npcTypeCount {
    false
  } else {
    difficultyScalingLookup->Array.getUnsafe(npcType)
  }
}
