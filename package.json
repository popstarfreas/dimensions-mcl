    "@rescript/language-server": "^1.70.0",
    "@rescript/linux-x64": "12.0.0-alpha.13",
    "dimensions": "../dimensions-core/module",
    "rescript": "^12.0.0",
    "rescript-dimensions": "../rescript-dimensions",
    "sury": "11.0.0-alpha.4",
    "terraria-packet": "github:popstarfreas/rescript-terrariapacket#07bc77f411cefe074336ab9a17e8f6f32dfc614d",
